# ============================================================
# Matching Engine Platform — Environment Variables
# ============================================================
# Copy to .env (gitignored) and fill in real values before
# running docker compose up.
# ============================================================

# REQUIRED: API key for the ops REST API (Bearer token).
# Must be a random string >= 32 chars.
# WARNING: by default, the portal admin password defaults to this
# value when portal.password is unset in platform.conf. For
# production, set portal.password separately in platform.conf.
OPS_API_KEY=change-me-to-a-random-32char-secret

# REQUIRED: HMAC signing key for JWT auth tokens issued by the daemon.
# Must be a random string >= 32 chars, DIFFERENT from OPS_API_KEY.
JWT_SIGNING_KEY=change-me-to-a-different-random-32char-secret

# OPTIONAL: Host port for the portal (default 80).
# Change this if port 80 is already in use on the host.
PORTAL_PORT=80

# OPTIONAL: Host port overrides (defaults in docker-compose.yml).
# FIX_PORT=19876
# MD_TCP_PORT=19877
# MD_MCAST_PORT=19878
# OPS_PORT=18080
# WS_PORT=18081
