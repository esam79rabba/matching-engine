        <mxCell id="subtitle" value="Fairness guarantees apply at the venue-controlled sequencing boundary. Network variability outside this boundary is not guaranteed." style="text;html=0;align=center;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontSize=9;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
