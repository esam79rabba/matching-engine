        </mxCell>

        <mxCell id="r_detect" value="1. Failure Detected&#xa;(watchdog heartbeat miss)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=1;" vertex="1" parent="recovery_zone">
          <mxGeometry x="30" y="40" width="200" height="40" as="geometry" />
        </mxCell>

