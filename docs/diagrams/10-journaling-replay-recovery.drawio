        <!-- ===== DURABILITY MODE NOTE ===== -->
        <mxCell id="dur_note" value="Durability Mode Impact on Recovery:&#xa;&#xa;Regulatory-Grade (sync fsync): RPO = zero data loss. Every journaled entry&#xa;was durable before processing. Recovery replays the complete, consistent journal.&#xa;&#xa;Reduced-Latency (batched): RPO = batch interval (e.g., 10-100 us). Last batch&#xa;may be lost on crash. Recovery replays to last durable batch boundary.&#xa;Suitable only where regulatory framework permits." style="shape=note;whiteSpace=wrap;html=0;backgroundOutline=1;size=15;fillColor=#ffffcc;strokeColor=#cccc00;fontSize=8;align=left;spacingLeft=5;" vertex="1" parent="1">
